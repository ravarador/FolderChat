@using FolderChat.Application.Attachments
@using FolderChat.Application.Chat
@using FolderChat.Application.Knowledge
@using FolderChat.Web.Infrastructure
@inject IFolderPicker FolderPicker
@{
    ViewData["Title"] = "Chat";
}

@section Sidebar {
    <div class="sidebar-actions">
        <button id="new-chat" class="btn btn-primary new-chat" type="button">
            <svg class="icon"><use href="#i-plus" /></svg>New chat
        </button>
        <label class="sidebar-search">
            <svg class="icon"><use href="#i-search" /></svg>
            <input id="conversation-search" class="form-control form-control-sm" type="search" placeholder="Search chats" aria-label="Search chats" />
        </label>
    </div>
    <nav id="conversation-list" class="conversation-list" aria-label="Conversations"></nav>
}

<section id="chat-main" class="chat-main">
    <header class="chat-header">
        <button class="icon-btn menu-btn" type="button" data-sidebar-open aria-label="Open menu" title="Chats and settings">
            <svg class="icon"><use href="#i-menu" /></svg>
        </button>
        <span id="chat-title" class="chat-title text-truncate"></span>
        <span id="privacy-badge" class="badge rounded-pill d-none"></span>
        <span id="chat-usage" class="chat-usage small text-body-secondary d-none"></span>
    </header>

    <div id="messages" class="messages" aria-live="polite"></div>

    <div id="empty-state" class="empty-state d-none">
        <span class="empty-mark" aria-hidden="true"><svg class="icon"><use href="#i-folder-open" /></svg></span>
        <h2 class="empty-title">What would you like to know?</h2>
        <p id="empty-state-text" class="text-body-secondary mb-0"></p>
    </div>

    <div id="drop-zone" class="drop-zone d-none" aria-hidden="true">Drop files to attach them</div>

    <form id="composer" class="composer" autocomplete="off"
          data-max-file-size="@AttachmentService.MaxFileSize" data-max-files="@ChatService.MaxAttachments" data-max-folders="@FolderAnswering.MaxFolders"
          data-choose-folders="@(FolderPicker.CanOpenFor(Context) ? "true" : "false")">
        <div class="composer-box">
            <div id="folder-bar" class="folder-bar d-none">
                <span class="folder-bar-label">Answering from</span>
                <span id="folder-chips" class="folder-chips" aria-label="Folders this chat answers from"></span>
                <select id="effort-picker" class="form-select form-select-sm effort-picker" aria-label="How hard to search the folders">
                    <option value="Quick" title="One search with your question. Fastest, and works with every model.">Quick</option>
                    <option value="Standard" title="The model searches the folders itself, trying other words if needed." selected>Standard</option>
                    <option value="Thorough" title="More searching, and the model can read whole pages. Slower, and uses more tokens.">Thorough</option>
                </select>
            </div>
            <div id="attachment-tray" class="attachment-tray d-none" aria-label="Attached files" aria-live="polite"></div>
            <textarea id="prompt" class="composer-input" rows="1" placeholder="Ask anything, or ask your folders" aria-label="Message"></textarea>
            <div class="composer-toolbar">
                <button id="attach" class="tool-btn" type="button" title="Attach PDF, Word or text files" aria-label="Attach files">
                    <svg class="icon"><use href="#i-paperclip" /></svg>
                </button>
                <input id="file-input" type="file" multiple hidden />
                <div class="dropup">
                    <button id="folders-button" class="tool-btn tool-btn-label" type="button"
                            data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"
                            title="Choose folders for this chat to answer from">
                        <svg class="icon"><use href="#i-folder" /></svg><span id="folders-button-text">Folders</span>
                    </button>
                    <div id="folder-menu" class="dropdown-menu folder-menu"></div>
                </div>
                <select id="model-picker" class="form-select form-select-sm model-picker" aria-label="Model"></select>
                <button id="send" class="send-btn" type="submit" aria-label="Send" title="Send (Enter)">
                    <svg class="icon"><use href="#i-arrow-up" /></svg>
                </button>
                <button id="stop" class="send-btn stop-btn d-none" type="button" aria-label="Stop" title="Stop the reply">
                    <svg class="icon"><use href="#i-square" /></svg>
                </button>
            </div>
        </div>
        <p class="composer-hint">Enter to send, Shift+Enter for a new line. Drop or paste files to attach them.</p>
    </form>
</section>

<div class="modal fade" id="preview-modal" tabindex="-1" aria-labelledby="preview-title" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h6 text-truncate" id="preview-title"></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="preview-info" class="small text-body-secondary"></p>
                <pre id="preview-text" class="preview-text mb-0"></pre>
            </div>
            <div id="preview-footer" class="modal-footer d-none">
                <button id="preview-reveal" type="button" class="btn btn-sm btn-outline-secondary">Show in folder</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="new-folder-modal" tabindex="-1" aria-labelledby="new-folder-title" aria-hidden="true">
    <div class="modal-dialog">
        <form id="new-folder-form" class="modal-content" autocomplete="off">
            <div class="modal-header">
                <h2 class="modal-title h5" id="new-folder-title">Add a folder</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body vstack gap-3">
                <p class="small text-body-secondary mb-0">
                    FolderChat reads the PDF, Word and text files in it, on this computer, and this chat answers from them.
                    Other chats can use it too, from their own Folders menu.
                </p>
                <div>
                    <label class="form-label" for="new-folder-path">Folder path</label>
                    <input id="new-folder-path" class="form-control" placeholder="@FolderPathHint.Example" required />
                    <div class="form-text">@FolderPathHint.Tip</div>
                </div>
                <div>
                    <label class="form-label" for="new-folder-name">Name (optional)</label>
                    <input id="new-folder-name" class="form-control" maxlength="100" />
                </div>
                <div id="new-folder-error" class="alert alert-danger d-none mb-0"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button id="new-folder-save" type="submit" class="btn btn-primary">Add folder</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/lib/marked/marked.umd.js"></script>
    <script src="~/lib/dompurify/purify.min.js"></script>
    <script src="~/lib/highlight.js/highlight.min.js"></script>
    <script src="~/js/markdown.js" asp-append-version="true"></script>
    <script src="~/js/chat.js" asp-append-version="true"></script>
}
