@using FolderChat.Web.Infrastructure
@inject IFolderPicker FolderPicker
@{
    ViewData["Title"] = "Settings";
    var canChooseFolders = FolderPicker.CanOpenFor(Context);
}

@section Sidebar {
    <nav class="settings-nav" aria-label="Settings sections">
        <a class="sidebar-link" asp-controller="Home" asp-action="Index"><svg class="icon"><use href="#i-message-square" /></svg>Back to chats</a>
        <div class="conversation-group">Settings</div>
        <a class="sidebar-link" href="#providers-heading"><svg class="icon"><use href="#i-cpu" /></svg>Providers</a>
        <a class="sidebar-link" href="#folders-heading"><svg class="icon"><use href="#i-folder" /></svg>Knowledge folders</a>
        <a class="sidebar-link" href="#api-keys-heading"><svg class="icon"><use href="#i-key-round" /></svg>API keys</a>
        <a class="sidebar-link" href="#usage-heading"><svg class="icon"><use href="#i-chart-column" /></svg>Usage</a>
    </nav>
}

<header class="chat-header settings-header">
    <button class="icon-btn menu-btn" type="button" data-sidebar-open aria-label="Open menu" title="Chats and settings">
        <svg class="icon"><use href="#i-menu" /></svg>
    </button>
    <span class="chat-title">Settings</span>
</header>

<div class="settings-page container py-4">
    <div class="d-flex align-items-center gap-2 mb-2">
        <h1 class="h4 mb-0" id="providers-heading">Providers</h1>
        <button id="add-provider" class="btn btn-primary btn-sm ms-auto" type="button">Add provider</button>
    </div>
    <p class="small text-body-secondary">
        API keys are encrypted on this computer and never sent back to the browser.
        Cloud providers receive the messages you send to their models; local providers keep everything on this machine.
    </p>

    <div id="provider-list" class="vstack gap-3"></div>
    <p id="no-providers" class="text-body-secondary d-none">No providers yet. Add one to start chatting.</p>

    <section class="mt-5" aria-labelledby="folders-heading">
        <div class="d-flex align-items-center gap-2 mb-2">
            <h2 class="h4 mb-0" id="folders-heading">Knowledge folders</h2>
            @if (canChooseFolders)
            {
                <button id="folder-choose" class="btn btn-primary btn-sm ms-auto" type="button">Choose folder…</button>
            }
        </div>
        <p class="small text-body-secondary">
            FolderChat reads the PDF, Word and text files in these folders, on this computer, so chats can answer from them.
            When you ask a question, only the passages it needs go to the model.
        </p>

        <form id="folder-form" class="row g-2 align-items-start mb-3" autocomplete="off">
            <div class="col-md">
                <label class="form-label small mb-1" for="folder-path">@(canChooseFolders ? "Or paste a folder's path" : "Folder path")</label>
                <input id="folder-path" class="form-control" placeholder="@FolderPathHint.Example" required />
                <div class="form-text">@FolderPathHint.Tip</div>
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1" for="folder-name">Name (optional)</label>
                <input id="folder-name" class="form-control" maxlength="100" />
            </div>
            <div class="col-md-auto folder-add-cell">
                <button id="folder-add" class="btn @(canChooseFolders ? "btn-outline-primary" : "btn-primary")" type="submit">Add folder</button>
            </div>
        </form>

        <div id="folder-list" class="vstack gap-3"></div>
        <p id="no-folders" class="text-body-secondary d-none">No folders yet. Add one here, or from Folders in any chat.</p>
    </section>

    <section class="mt-5" aria-labelledby="api-keys-heading">
        <h2 class="h4 mb-2" id="api-keys-heading">API keys</h2>
        <p class="small text-body-secondary">
            Your other apps can ask FolderChat questions through its REST API at <code>/api/v1</code>, from their server, with one of these keys.
            Chats they start show in your chat list with an API badge.
            <a href="https://github.com/ravarador/FolderChat/blob/main/docs/api.md" target="_blank" rel="noopener noreferrer">How to use the API</a>
        </p>

        <form id="api-key-form" class="row g-2 align-items-end mb-3" autocomplete="off">
            <div class="col-md">
                <label class="form-label small mb-1" for="api-key-name">Name</label>
                <input id="api-key-name" class="form-control" maxlength="100" placeholder="Admin app" required />
            </div>
            <div class="col-md-auto">
                <button id="api-key-create" class="btn btn-outline-primary" type="submit">Create key</button>
            </div>
        </form>

        <div id="api-key-new" class="alert alert-success d-none" role="status">
            <div class="fw-semibold mb-1">Copy this key now. FolderChat keeps only a fingerprint of it, so it can't be shown again.</div>
            <div class="input-group">
                <input id="api-key-secret" class="form-control font-monospace" readonly aria-label="New API key" />
                <button id="api-key-copy" class="btn btn-success" type="button">Copy</button>
            </div>
        </div>

        <div id="api-key-table" class="table-responsive d-none">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Key</th>
                        <th scope="col">Created</th>
                        <th scope="col">Last used</th>
                        <th scope="col"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody id="api-key-rows"></tbody>
            </table>
        </div>
        <p id="no-api-keys" class="text-body-secondary d-none">No keys yet, so the API is closed.</p>
    </section>

    <section class="mt-5" aria-labelledby="usage-heading">
        <div class="d-flex align-items-center gap-2 mb-2">
            <h2 class="h4 mb-0" id="usage-heading">Usage this month</h2>
            <button id="usage-refresh" class="btn btn-outline-secondary btn-sm ms-auto" type="button">Refresh</button>
        </div>
        <p class="small text-body-secondary">
            Tokens your chats used since <span id="usage-since">the start of the month</span>, as each provider reported them.
            Your providers bill by tokens, so their own dashboards show what you'll pay. Deleting a chat removes its replies from these totals.
        </p>
        <div id="usage-table" class="table-responsive d-none">
            <table class="table table-sm align-middle usage-table">
                <thead>
                    <tr>
                        <th scope="col">Model</th>
                        <th scope="col" class="text-end">Replies</th>
                        <th scope="col" class="text-end">Read (in)</th>
                        <th scope="col" class="text-end">Written (out)</th>
                        <th scope="col" class="text-end">From cache</th>
                        <th scope="col" class="text-end">Thinking</th>
                    </tr>
                </thead>
                <tbody id="usage-rows"></tbody>
                <tfoot id="usage-total"></tfoot>
            </table>
        </div>
        <p id="no-usage" class="text-body-secondary d-none">No replies this month yet.</p>
    </section>
</div>

<div class="modal fade" id="folder-modal" tabindex="-1" aria-labelledby="folder-modal-title" aria-hidden="true">
    <div class="modal-dialog">
        <form id="folder-edit-form" class="modal-content" autocomplete="off">
            <div class="modal-header">
                <h2 class="modal-title h5" id="folder-modal-title">Edit folder</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body vstack gap-3">
                <div>
                    <label class="form-label" for="folder-edit-name">Name</label>
                    <input id="folder-edit-name" class="form-control" maxlength="100" required />
                </div>
                <div>
                    <div class="form-check form-switch">
                        <input id="folder-summaries" class="form-check-input" type="checkbox" />
                        <label class="form-check-label" for="folder-summaries">Write a short summary of each file</label>
                    </div>
                    <div class="form-text">
                        Thorough answers use the summaries to pick which files to read.
                        A model reads the start of every file to write them, which takes a while for big folders.
                    </div>
                </div>
                <div id="folder-summary-model-group" class="d-none">
                    <label class="form-label" for="folder-summary-model">Model that writes the summaries</label>
                    <select id="folder-summary-model" class="form-select"></select>
                    <div id="folder-summary-privacy" class="form-text"></div>
                </div>
                <div id="folder-edit-error" class="alert alert-danger d-none mb-0"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button id="folder-edit-save" type="submit" class="btn btn-primary">Save</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="provider-modal" tabindex="-1" aria-labelledby="provider-modal-title" aria-hidden="true">
    <div class="modal-dialog">
        <form id="provider-form" class="modal-content" autocomplete="off">
            <div class="modal-header">
                <h2 class="modal-title h5" id="provider-modal-title">Add provider</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body vstack gap-3">
                <div id="preset-group">
                    <label class="form-label" for="provider-preset">Start from</label>
                    <select id="provider-preset" class="form-select"></select>
                </div>
                <div>
                    <label class="form-label" for="provider-name">Name</label>
                    <input id="provider-name" class="form-control" maxlength="100" required />
                </div>
                <div>
                    <label class="form-label" for="provider-kind">Type</label>
                    <select id="provider-kind" class="form-select">
                        <option value="Anthropic">Anthropic</option>
                        <option value="OpenAI">OpenAI</option>
                        <option value="OpenAICompatible">OpenAI-compatible</option>
                        <option value="Ollama">Ollama</option>
                    </select>
                    <div id="kind-hint" class="form-text text-warning-emphasis d-none"></div>
                </div>
                <div>
                    <label class="form-label" for="provider-base-url">Base URL</label>
                    <input id="provider-base-url" class="form-control" type="url" placeholder="Leave blank for the provider's default" />
                </div>
                <div>
                    <label class="form-label" for="provider-api-key">API key</label>
                    <input id="provider-api-key" class="form-control" type="password" autocomplete="new-password" />
                    <div id="api-key-help" class="form-text"></div>
                </div>
                <div class="form-check form-switch">
                    <input id="provider-enabled" class="form-check-input" type="checkbox" checked />
                    <label class="form-check-label" for="provider-enabled">Enabled</label>
                </div>
                <div id="preset-notes" class="small text-body-secondary"></div>
                <div id="provider-error" class="alert alert-danger d-none mb-0"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button id="provider-save" type="submit" class="btn btn-primary">Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/settings.js" asp-append-version="true"></script>
    <script src="~/js/folders.js" asp-append-version="true"></script>
    <script src="~/js/usage.js" asp-append-version="true"></script>
    <script src="~/js/apikeys.js" asp-append-version="true"></script>
}
