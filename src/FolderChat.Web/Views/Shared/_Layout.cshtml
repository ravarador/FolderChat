@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var page = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <meta name="theme-color" content="#0f766e" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <title>@ViewData["Title"] · FolderChat</title>
    <script>
        // Apply the saved or system theme before the page paints, to avoid a flash.
        (() => {
            let theme = null;
            try { theme = localStorage.getItem("folderchat.theme"); } catch { }
            theme ??= matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
            document.documentElement.dataset.bsTheme = theme;
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/highlight.js/styles/github.min.css" id="hljs-light" />
    <link rel="stylesheet" href="~/lib/highlight.js/styles/github-dark.min.css" id="hljs-dark" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <partial name="_Icons" />

    <div class="app-shell">
        <aside id="sidebar" class="app-sidebar" aria-label="FolderChat">
            <div class="sidebar-top">
                <a class="brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark" aria-hidden="true"><svg class="icon"><use href="#i-folder-open" /></svg></span>
                    <span class="brand-name">FolderChat</span>
                </a>
                <button class="icon-btn sidebar-close" type="button" data-sidebar-close aria-label="Close menu" title="Close menu">
                    <svg class="icon"><use href="#i-x" /></svg>
                </button>
            </div>

            @RenderSection("Sidebar", required: false)

            <div class="sidebar-footer">
                <a class="sidebar-link @(page == "Settings" ? "active" : "")" asp-controller="Home" asp-action="Settings">
                    <svg class="icon"><use href="#i-settings" /></svg>Settings
                </a>
                <button id="install-app" class="sidebar-link d-none" type="button" title="Add FolderChat to your Start menu, Dock or desktop, and open it in its own window">
                    <svg class="icon"><use href="#i-download" /></svg>Install app
                </button>
                <button id="theme-toggle" class="sidebar-link" type="button" title="Switch light or dark theme">
                    <svg class="icon theme-icon-dark"><use href="#i-moon" /></svg><svg class="icon theme-icon-light"><use href="#i-sun" /></svg><span class="theme-label">Dark theme</span>
                </button>
            </div>
        </aside>
        <div class="sidebar-scrim" data-sidebar-close aria-hidden="true"></div>

        <main class="app-main">
            @RenderBody()
        </main>
    </div>

    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toasts"></div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
